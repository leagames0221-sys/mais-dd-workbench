.vscode/
.idea/
*.swp
*.swo
.DS_Store
Thumbs.db

# Security Master telemetry (T1 学び: heartbeat path は実環境で internal/.*.heartbeat 形式)
.security_telemetry.jsonl
.security_heartbeat.json
.security_heartbeat.jsonl
internal/.git_secret_scan.heartbeat
internal/.security_intercept.heartbeat
internal-heartbeat-files
internal-jsonl-files
