# Security Master Layer 1 — credentials + secrets literal block
.env
.env.*
!.env.example
*.pem
*.key
secrets/
.credentials

# Synthetic VDR data (large + repo 外保管)
data/vdr_synthetic/**/*.pdf
data/vdr_synthetic/**/*.docx
data/vdr_synthetic/**/*.pptx
data/vdr_synthetic/**/*.xlsx
data/vdr_synthetic/**/*.xls
data/vdr_synthetic/**/*.doc
data/cache/
data/audit/*.jsonl
data/vault/*.enc

# Python
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
.venv/
venv/
env/
ENV/
build/
dist/
*.egg-info/
.eggs/
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/
.tox/

# Model cache (HF / sentence-transformers / docling)
.cache/
